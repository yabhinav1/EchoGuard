# Backend
PORT=4000
AWS_REGION=us-east-1
# Leave blank to run in demo mode (in-memory DB)
TABLE_NAME=
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
SNS_TOPIC_ARN=
ALERT_EMAIL=
# Optional paid services (off by default; the app works fully without them)
USE_BEDROCK=false
USE_TEXTRACT=false
# Plaid bank sync (https://dashboard.plaid.com), sandbox keys are free
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# KMS key used to encrypt Plaid access tokens at rest (set automatically when deployed)
KMS_KEY_ID=
# Alexa: map Alexa account ids to EchoGuard users, "amzn1.ask.account.X=userId"
ALEXA_USER_MAP=
# Alexa: reject requests from any other skill
ALEXA_SKILL_ID=

# Frontend
VITE_API_URL=http://localhost:4000
# Cognito Hosted UI (leave blank for demo-user mode)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT=http://localhost:5173/
